{"version":2,"kind":"Article","sha256":"90b2d07d56c898359242aa35801051deef0630c3184a9ec6624ad99ca58fe9af","slug":"researchpapers","location":"/82ResearchPapers.md","dependencies":[],"frontmatter":{"title":"8.2 Research Paper","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Vijay Vulava","given":"Vijay","family":"Vulava"},"name":"Vijay Vulava","orcid":"0000-0001-9011-3081","affiliations":["https://charleston.edu/"],"id":"contributors-Users\\VulavaV\\OneDrive - College of Charleston\\1 Authoring\\313czs\\myst-generated-uid-0"}],"date":"2026-01-08","license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true},"code":{"id":"GPL-3.0-or-later","url":"https://opensource.org/licenses/GPL-3.0","name":"GNU General Public License v3.0 or later","free":true,"osi":true}},"github":"https://github.com/vijayvulava/313czs","keywords":[],"affiliations":[{"id":"https://charleston.edu/","name":"https://charleston.edu/"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"82ResearchPapers.md","url":"/82ResearchPapers-7d96be229b84996ac18e7d0b5432bdab.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Research projects will focus on description and characterization of how interaction among the atmosphere, lithosphere, hydrosphere, biosphere, and soil (The Critical Zone) support and influence life. A 10-minute presentation, and a 3000-word, properly-referenced report of the student-identified and instructor-approved topic that addresses one of the grand challenges in geosciences and the role that the CZ plays.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TtnO6WbKLU"}],"key":"x2ztEPGovA"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Goal of Research Paper","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cDgl2qAnfz"}],"identifier":"goal-of-research-paper","label":"Goal of Research Paper","html_id":"goal-of-research-paper","implicit":true,"key":"niaIj0DUSV"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Scholarly articles are built to convey ideas around a research endeavor and are built to answer the “five W’s”:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"rVeN0Nfr1H"}],"key":"xWdKJc14O2"},{"type":"blockquote","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"What, Why, When, Where, and What did they find?","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"yXlFCdFRpi"}],"key":"uYT7kJ6CIx"}],"key":"Xwp0AQfmwv"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"A proper article will also be built on the shoulders of previous work, and the research question posed by the authors will clearly follow from that past work in way that emphasizes the author’s knowledge of the subject area and his/her creativity and curiosity to pose a new, novel question.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"MoTp5gkBNw"}],"key":"OAxKTIiqLF"},{"type":"heading","depth":3,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Structure","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ctOkbzZQCh"}],"identifier":"structure","label":"Structure","html_id":"structure","implicit":true,"key":"j4ARzL79gh"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The following are important sections that are to be included in your research term paper. The points next to each section are the relative grade distribution for the research paper. The following are important sections that are to included in your research paper.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"G6TZ0j3iVB"}],"key":"YYBeavcHLb"},{"type":"heading","depth":4,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Title","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"OmPWlbiUMT"}],"identifier":"title","label":"Title","html_id":"title","implicit":true,"key":"cBrRZtKwDX"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Should be concise and informative. The title should cover all the main themes of your final project. Titles are often used in information-retrieval systems, so be sure to cover all the main keywords in your title. Avoid abbreviations and formulae.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"trW03NB1Li"}],"key":"ft56kxknLo"},{"type":"heading","depth":4,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Abstract","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"PKYPZH4ncv"}],"identifier":"abstract","label":"Abstract","html_id":"abstract","implicit":true,"key":"X5VCQOKPOp"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"A concise and factual abstract (maximum length 100-150 words) -- this is your “elevator pitch” to someone regarding the major findings of your final project. The abstract should briefly state the purpose of the research, the principal findings, and major conclusions. An abstract is often presented separately from the article, so it must be able to stand alone. Non-standard or uncommon abbreviations should be avoided, but if essential they must be defined at their first mention in the abstract itself.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"vzKD0nH0U1"}],"key":"CgSVMNPJgw"},{"type":"heading","depth":4,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"HqzcLoQ23o"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"pBIt5gHmg1"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Introduce the rationale for the study and outline the objectives and possible hypotheses (maximum length 500-750 words). Avoid a detailed literature survey on the subject or a summary of the results from the current study. Include a methodology of how you collected your information, data, etc.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"M1gthefXSx"}],"key":"EmlwTAPN1v"},{"type":"heading","depth":4,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Results and Discussion","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"rUB5Yw6Ewq"}],"identifier":"results-and-discussion","label":"Results and Discussion","html_id":"results-and-discussion","implicit":true,"key":"k5yskxdok0"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Clear and concise description of your results of your investigation (maximum length 1000-1250 words). Discussion should explore the significance of the results. A combined Results and Discussion section is often appropriate, but you can also separate them. Avoid extensive citations and discussion of published literature.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"D8pkr31lks"}],"key":"jyPBRuDr7D"},{"type":"heading","depth":4,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Conclusions","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Ku2M11X8mR"}],"identifier":"conclusions","label":"Conclusions","html_id":"conclusions","implicit":true,"key":"r4o0644RYi"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The main conclusions of the study (maximum length 100-150 words) may be presented in a short Conclusions section, which may stand alone or form a subsection of a ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ugQGIl1Bjm"},{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Discussion","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"QVduWsLLv7"}],"key":"xSREsHrZNd"},{"type":"text","value":" or ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"CefwNPqCXc"},{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Results and Discussion","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"WWcMRWNusE"}],"key":"n8lr2nmSlZ"},{"type":"text","value":" section.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ozj1JheP9C"}],"key":"cHqgkheeR0"},{"type":"heading","depth":4,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"References","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"wQKwLhBd5L"}],"identifier":"references","label":"References","html_id":"references","implicit":true,"key":"xRwy9aWwDm"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Include at least 10 research articles that are cited in the body of the research paper. Provide a list (alphabetically) of all the articles, books, etc. you cited in your paper. Use the ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"jgshWmjQqd"},{"type":"link","url":"http://www.chicagomanualofstyle.org/tools_citationguide.html","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Chicago Manual of Style","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"EPpJfEFI8c"}],"urlSource":"http://www.chicagomanualofstyle.org/tools_citationguide.html","key":"hz1yfV99sf"},{"type":"text","value":" for formatting. I highly recommend using the ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"hf4z9bP7Wo"},{"type":"link","url":"https://www.mendeley.com/guides","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Mendeley Reference Manager","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Tj1szri4ui"}],"urlSource":"https://www.mendeley.com/guides","key":"Rp4pumBAG3"},{"type":"text","value":" for managing your bibliography.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"jHi84OxhIp"}],"key":"R0jGpnIHSn"},{"type":"heading","depth":4,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Figures and Tables","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"aHKDGELPwl"}],"identifier":"figures-and-tables","label":"Figures and Tables","html_id":"figures-and-tables","implicit":true,"key":"rSaB2L5gQA"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Figures and tables should convey key information and need to be embedded in the main paper and not at the end. Each figure and table needs a caption. A caption should comprise a brief title and a description of the illustration or the data in the table and include citations for the source of the figure or table. Keep text in the illustrations themselves to a minimum but explain all symbols and abbreviations used. Number tables and figures consecutively in accordance with their appearance in the text. All figures and tables need to be cited in the body of the paper.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"fjbZ9fxkJj"}],"key":"u6BeLhDt7D"},{"type":"heading","depth":3,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Writing style","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"UAt7d1tcZl"}],"identifier":"writing-style","label":"Writing style","html_id":"writing-style","implicit":true,"key":"KIeTRSV6u0"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"There is some debate about using active (“We found that...”) vs. passive voice (“The results show that...”). Technical writing usually is in passive voice, but journals are becoming more willing to consider well-written papers using the active voice.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"DAE4UoWQe9"}],"key":"Iidv6ixFwq"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Verb tenses: A common problem is using mixed verb-tense. Just remember when you write about something in the past, use past tense (the Methods section should be entirely in past tense). The Results section and Discussion sections can have some mixed tenses as appropriate (e.g., “The results show that ...” or “There was an inverse relationship between temperature and specific conductance as measured in the stream samples...”). Also, in the Discussion it may be appropriate to use future verb tense (“These results will be used to guide management decisions ...”)","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"GEpNHEX0TQ"}],"key":"cDR0TY4rmg"},{"type":"heading","depth":3,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Literature review","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"OsQEXejUML"}],"identifier":"literature-review","label":"Literature review","html_id":"literature-review","implicit":true,"key":"wp6I3W0zdM"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"The following databases are comprehensive for your literature reviews: ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"wYbfFAuWR8"},{"type":"link","url":"https://www.jstor.org/","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"JSTOR","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"CD65HHKFRn"}],"urlSource":"https://www.jstor.org/","key":"esb7HR0chg"},{"type":"text","value":", [Google Scholar]\n(","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"aCbXzOJEub"},{"type":"link","url":"https://scholar.google.com/","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"https://​scholar​.google​.com/","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"atTfLKvrAC"}],"urlSource":"https://scholar.google.com/","key":"ZpAtCJg7r7"},{"type":"t